# ─────────────────────────────────────────────────────────────
# Google Sheets Backend — Environment Variables
# ─────────────────────────────────────────────────────────────
#
# Copy this file to .env.local for local development with `netlify dev`
# Set the same variables in Netlify Dashboard → Site Settings → Environment Variables

# The entire JSON of your Google Service Account key file (as a single-line string)
# Get this from: Google Cloud Console → IAM → Service Accounts → Keys → Add Key → JSON
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"...","token_uri":"..."}

# The Google Sheet ID — found in the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
SHEET_ID=your_google_sheet_id_here

# Shared secret for the SMS ingest endpoint (also stored in the iOS Shortcut)
INGEST_SECRET=change-me-to-a-long-random-string

# Same value as INGEST_SECRET, exposed to the frontend paste box
VITE_INGEST_SECRET=change-me-to-a-long-random-string
